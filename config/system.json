{
  "hostname": "MOS",
  "keymap": "us",
  "timezone": "Europe/London",
  "display": {
    "timeout": 30,
    "powersave": "on",
    "powerdown": 60
  },
  "persist_history": false,
  "persist_notifications": false,
  "webui": {
    "ports": {
      "http": 80,
      "https": 443
    },
    "https_enabled": true,
    "local_dns_searchname": "local",
    "listen_interfaces": []
  },
  "ntp": {
    "enabled": true,
    "mode": "iburst",
    "servers": [
      "0.pool.ntp.org",
      "1.pool.ntp.org"
    ]
  },
  "notification_sound": {
    "startup": true,
    "reboot": true,
    "shutdown": true
  },
  "global_spindown": "20",
  "cpufreq": {
    "governor": "ondemand",
    "max_speed": null,
    "min_speed": null
  },
 "swapfile": {
    "enabled": false,
    "path": null,
    "size": null,
    "priority": -2,
    "config": {
      "zswap": false,
      "shrinker": true,
      "max_pool_percent": 20,
      "compressor": "zstd",
      "zpool": "zsmalloc",
      "accept_threshold_percent": 90
    }
  },
  "binfmt": {
    "enabled": false,
    "architectures": []
  },
  "webui": {
    "ports": {
      "http": 80
    },
    "listen_interfaces": []
  },
  "update_check": {
    "enabled": true,
    "update_check_schedule": "15 9 * * *"
  },
  "logsize": 200
}
